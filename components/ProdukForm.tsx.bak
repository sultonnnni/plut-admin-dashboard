"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { ApiError } from "@/lib/api";
import { BADGES, CATEGORIES, onlyDigits, Produk, ProdukValues, slugify } from "@/lib/produk";

type Props = {
  mode: "create" | "edit";
  initial?: Produk;
  onSubmit: (v: ProdukValues) => Promise<unknown>;
};

const inputCls =
  "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 disabled:bg-gray-100 disabled:text-gray-500";
const labelCls = "mb-1 block text-sm font-medium text-gray-700";

export default function ProdukForm({ mode, initial, onSubmit }: Props) {
  const router = useRouter();
  const [slugTouched, setSlugTouched] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [errors, setErrors] = useState<Record<string, string[]>>({});
  const [v, setV] = useState<ProdukValues>({
    name: initial?.name ?? "",
    slug: initial?.slug ?? "",
    category: initial?.category ?? "",
    price: onlyDigits(initial?.price ?? ""),
    priceTouched: false,
    stock: String(initial?.stock ?? 99),
    badge: initial?.badge || "Produk Unggulan",
    image: initial?.image ?? "",
    description: initial?.description ?? "",
  });

  const categories = CATEGORIES.map((c) => c.label);
  if (initial?.category && !categories.includes(initial.category)) categories.push(initial.category);

  function set<K extends keyof ProdukValues>(key: K, value: ProdukValues[K]) {
    setV((prev) => ({ ...prev, [key]: value }));
  }
  function onName(value: string) {
    setV((prev) => ({
      ...prev,
      name: value,
      slug: mode === "create" && !slugTouched ? slugify(value) : prev.slug,
    }));
  }
  const fieldError = (k: string) =>
    errors[k]?.[0] ? <p className="mt-1 text-xs text-red-600">{errors[k][0]}</p> : null;

  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setSaving(true);
    setError("");
    setErrors({});
    try {
      await onSubmit(v);
      router.push("/admin/dashboard/products");
    } catch (err) {
      const apiErr = err as ApiError;
      setErrors(apiErr.errors ?? {});
      setError(apiErr.errors ? "Periksa kembali isian yang ditandai." : apiErr.message || "Gagal menyimpan.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <form onSubmit={handleSubmit} className="max-w-3xl rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      {error && (
        <div role="alert" className="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )}

      <div className="grid gap-4 sm:grid-cols-2">
        <div className="sm:col-span-2">
          <label className={labelCls}>Nama produk</label>
          <input className={inputCls} value={v.name} onChange={(e) => onName(e.target.value)} />
          {fieldError("name")}
        </div>

        <div className="sm:col-span-2">
          <label className={labelCls}>Slug {mode === "edit" && <span className="font-normal text-gray-400">(tidak bisa diubah)</span>}</label>
          <input
            className={inputCls}
            value={v.slug}
            disabled={mode === "edit"}
            onChange={(e) => {
              setSlugTouched(true);
              set("slug", e.target.value);
            }}
          />
          {fieldError("slug")}
        </div>

        <div>
          <label className={labelCls}>Kategori</label>
          <select className={inputCls} value={v.category} onChange={(e) => set("category", e.target.value)}>
            <option value="">Pilih kategori…</option>
            {categories.map((c) => (
              <option key={c} value={c}>
                {c}
              </option>
            ))}
          </select>
          {fieldError("category")}
        </div>

        <div>
          <label className={labelCls}>Badge</label>
          <select className={inputCls} value={v.badge} onChange={(e) => set("badge", e.target.value)}>
            {BADGES.map((b) => (
              <option key={b} value={b}>
                {b}
              </option>
            ))}
          </select>
          {fieldError("badge")}
        </div>

        <div>
          <label className={labelCls}>Harga (Rp, angka saja)</label>
          <input
            className={inputCls}
            inputMode="numeric"
            placeholder="16500"
            value={v.price}
            onChange={(e) => setV((prev) => ({ ...prev, price: onlyDigits(e.target.value), priceTouched: true }))}
          />
          {mode === "edit" && initial && (
            <p className="mt-1 text-xs text-gray-500">Harga saat ini: {initial.price_label || initial.price || "-"}</p>
          )}
          {fieldError("price")}
        </div>

        <div>
          <label className={labelCls}>Stok</label>
          <input
            className={inputCls}
            inputMode="numeric"
            value={v.stock}
            onChange={(e) => set("stock", onlyDigits(e.target.value))}
          />
          {fieldError("stock")}
        </div>

        <div className="sm:col-span-2">
          <label className={labelCls}>Gambar (path atau URL)</label>
          <input
            className={inputCls}
            placeholder="/produks/nama-file.jpg"
            value={v.image}
            onChange={(e) => set("image", e.target.value)}
          />
          {fieldError("image")}
        </div>

        <div className="sm:col-span-2">
          <label className={labelCls}>Deskripsi</label>
          <textarea className={inputCls} rows={4} value={v.description} onChange={(e) => set("description", e.target.value)} />
          {fieldError("description")}
        </div>
      </div>

      <div className="mt-6 flex gap-3">
        <button
          disabled={saving}
          className="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500 disabled:opacity-60"
        >
          {saving ? "Menyimpan…" : "Simpan"}
        </button>
        <button
          type="button"
          onClick={() => router.back()}
          className="rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-200"
        >
          Batal
        </button>
      </div>
    </form>
  );
}