"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { CATEGORIES, deleteProduk, displayPrice, fetchAllProduk, LOW_STOCK, Produk } from "@/lib/produk";

const PER_PAGE = 20;

export default function ProductsPage() {
  const [items, setItems] = useState<Produk[]>([]);
  const [q, setQ] = useState("");
  const [cat, setCat] = useState("");
  const [page, setPage] = useState(1);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    fetchAllProduk()
      .then(setItems)
      .catch((e) => setError(e.message))
      .finally(() => setLoading(false));
  }, []);

  const filtered = useMemo(() => {
    const s = q.trim().toLowerCase();
    return items.filter(
      (p) => (!cat || p.category === cat) && (!s || p.name.toLowerCase().includes(s) || p.slug.toLowerCase().includes(s))
    );
  }, [items, q, cat]);

  const pages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
  const current = Math.min(page, pages);
  const rows = filtered.slice((current - 1) * PER_PAGE, current * PER_PAGE);

  async function remove(p: Produk) {
    if (!confirm('Hapus "' + p.name + '"? Tindakan ini tidak bisa dibatalkan.')) return;
    try {
      await deleteProduk(p.id);
      setItems((prev) => prev.filter((x) => x.id !== p.id));
    } catch (e) {
      setError((e as Error).message);
    }
  }

  return (
    <main className="mx-auto max-w-6xl p-6 sm:p-8">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <h1 className="text-2xl font-bold">Produk UMKM ({items.length})</h1>
        <Link
          href="/admin/dashboard/products/new"
          className="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500"
        >
          + Tambah produk
        </Link>
      </div>

      {error && (
        <div className="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>
      )}

      <div className="mt-4 flex flex-wrap gap-3">
        <input
          value={q}
          onChange={(e) => {
            setQ(e.target.value);
            setPage(1);
          }}
          placeholder="Cari nama atau slug…"
          className="w-full max-w-xs rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20"
        />
        <select
          value={cat}
          onChange={(e) => {
            setCat(e.target.value);
            setPage(1);
          }}
          className="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm outline-none focus:border-emerald-500"
        >
          <option value="">Semua kategori</option>
          {CATEGORIES.map((c) => (
            <option key={c.id} value={c.label}>
              {c.label}
            </option>
          ))}
        </select>
      </div>

      <div className="mt-4 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        {loading ? (
          <p className="p-6 text-sm text-gray-500">Memuat data…</p>
        ) : (
          <table className="w-full text-left text-sm">
            <thead className="border-b border-gray-200 bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th className="px-4 py-3">ID</th>
                <th className="px-4 py-3">Nama</th>
                <th className="px-4 py-3">Kategori</th>
                <th className="px-4 py-3">Harga</th>
                <th className="px-4 py-3">Stok</th>
                <th className="px-4 py-3">Badge</th>
                <th className="px-4 py-3" />
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-100">
              {rows.map((p) => (
                <tr key={p.id} className="hover:bg-gray-50">
                  <td className="px-4 py-3 text-gray-500">{p.id}</td>
                  <td className="px-4 py-3 font-medium">{p.name}</td>
                  <td className="px-4 py-3">{p.category}</td>
                  <td className="px-4 py-3 whitespace-nowrap">{displayPrice(p)}</td>
                  <td className={"px-4 py-3 " + (p.stock <= LOW_STOCK ? "font-semibold text-red-600" : "")}>{p.stock}</td>
                  <td className="px-4 py-3">
                    <span className="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">{p.badge}</span>
                  </td>
                  <td className="px-4 py-3 text-right whitespace-nowrap">
                    <Link href={"/admin/dashboard/products/" + p.id + "/edit"} className="mr-3 text-emerald-700 hover:underline">
                      Edit
                    </Link>
                    <button onClick={() => remove(p)} className="text-red-600 hover:underline">
                      Hapus
                    </button>
                  </td>
                </tr>
              ))}
              {rows.length === 0 && (
                <tr>
                  <td colSpan={7} className="px-4 py-8 text-center text-gray-500">
                    Tidak ada produk yang cocok.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        )}
      </div>

      <div className="mt-4 flex items-center justify-between text-sm text-gray-600">
        <span>
          {filtered.length} produk · halaman {current} dari {pages}
        </span>
        <div className="flex gap-2">
          <button
            disabled={current <= 1}
            onClick={() => setPage(current - 1)}
            className="rounded-md border border-gray-300 bg-white px-3 py-1.5 disabled:opacity-40"
          >
            Sebelumnya
          </button>
          <button
            disabled={current >= pages}
            onClick={() => setPage(current + 1)}
            className="rounded-md border border-gray-300 bg-white px-3 py-1.5 disabled:opacity-40"
          >
            Berikutnya
          </button>
        </div>
      </div>
    </main>
  );
}