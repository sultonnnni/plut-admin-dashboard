import axios from "axios"; const API_ORIGIN = (process.env.NEXT_PUBLIC_API_URL ?? "http://127.0.0.1:8000").replace(/\/\$/, ""); export const http = axios.create({ baseURL: API_ORIGIN, headers: { Accept: "application/json", "X-Requested-With": "XMLHttpRequest" } }); http.interceptors.request.use((config) => { if (typeof window !== "undefined") { const token = localStorage.getItem("admin_token"); if (token) { config.headers.Authorization = `Bearer ${token}`; } } return config; }); http.interceptors.response.use((res) => res, (err) => { if (err.response?.status === 401 && typeof window !== "undefined") { localStorage.removeItem("admin_token"); window.location.href = "/admin/login"; } return Promise.reject(err); }); export type Product = { id: number; name: string; price: number | string; category?: string | null; description?: string | null; image?: string | null; badge?: string | null; stok: number; }; export async function fetchAllProducts(): Promise<Product[]> { const { data } = await http.get("/api/produks"); return Array.isArray(data) ? data : data?.data || []; }